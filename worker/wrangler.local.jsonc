{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albumrobot-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "vars": {
    "PRIMARY_GROUP_ID": "local-probe-group",
    "GROUP_PASSWORD": "albumrobot-local-password",
    "SESSION_SECRET": "albumrobot-local-session-secret-not-for-production",
    "SYNC_TOKEN": "albumrobot-local-sync-token-not-production",
    "ALLOW_LOCAL_GROUP_OVERRIDE": "true",
  },
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albumrobot-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "albumrobot-local",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "24081501",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
