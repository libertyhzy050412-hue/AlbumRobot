{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albumrobot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albumrobot-prod",
      "database_id": "495cff41-2007-4e70-bfd5-2c083d37f2c8",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "24081501",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
