{
  "name": "@albumrobot/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node ../scripts/production-preflight.mjs && wrangler deploy",
    "dev": "wrangler dev --config wrangler.local.jsonc --local",
    "db:migrate:local": "wrangler d1 migrations apply albumrobot-local --config wrangler.local.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply albumrobot-prod --remote",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@albumrobot/contracts": "workspace:*",
    "hono": "^4.9.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.29.0"
  }
}
